{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "screen-annotator.project"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 9007199254740991,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 9007199254740991,
          "multipleOf": 2
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "srt": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "background": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            {
              "type": "object",
              "properties": {
                "gradient": {
                  "type": "object",
                  "properties": {
                    "angle": {
                      "type": "number"
                    },
                    "colors": {
                      "minItems": 2,
                      "maxItems": 4,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                      }
                    }
                  },
                  "required": [
                    "colors"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "gradient"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "image"
              ],
              "additionalProperties": false
            }
          ]
        },
        "margin": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "right": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "bottom": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "left": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "additionalProperties": false
        },
        "fit": {
          "type": "string",
          "enum": [
            "contain",
            "cover"
          ]
        },
        "shadow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "styles": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "object",
          "properties": {
            "font": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "lineHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "align": {
              "type": "string",
              "enum": [
                "center",
                "left"
              ]
            },
            "background": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                {
                  "type": "string",
                  "const": "auto"
                }
              ]
            },
            "position": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "pointer": {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "highlighter": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "speech": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "additionalProperties": false
        },
        "speech": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dictionary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "in": {
            "type": "number",
            "minimum": 0
          },
          "out": {
            "type": "number",
            "minimum": 0
          },
          "speed": {
            "type": "number",
            "minimum": 1
          },
          "caption": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "style": {
                "type": "object",
                "properties": {
                  "font": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "lineHeight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "align": {
                    "type": "string",
                    "enum": [
                      "center",
                      "left"
                    ]
                  },
                  "background": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                      },
                      {
                        "type": "string",
                        "const": "auto"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "speech": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "voice": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "audio": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                },
                "additionalProperties": false
              },
              "speech": {
                "type": "object",
                "properties": {
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "holds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "at",
                "duration"
              ],
              "additionalProperties": false
            }
          },
          "zooms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "rect": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                },
                "hold": {
                  "type": "boolean"
                },
                "transition": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "start",
                "end",
                "rect"
              ],
              "additionalProperties": false
            }
          },
          "pointers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "line",
                    "freehand"
                  ]
                },
                "path": {
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "number",
                        "minimum": 0
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "t",
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "enter": {
                  "type": "string",
                  "enum": [
                    "none",
                    "fade",
                    "flash"
                  ]
                },
                "exit": {
                  "type": "string",
                  "enum": [
                    "none",
                    "fade",
                    "flash"
                  ]
                },
                "style": {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "size": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "mode",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "line",
                    "freehand"
                  ]
                },
                "path": {
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "number",
                        "minimum": 0
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "t",
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "enter": {
                  "type": "string",
                  "enum": [
                    "none",
                    "fade",
                    "flash"
                  ]
                },
                "exit": {
                  "type": "string",
                  "enum": [
                    "none",
                    "fade",
                    "flash"
                  ]
                },
                "style": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "type": "string",
                      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "mode",
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "source",
          "in",
          "out"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "sources",
    "steps"
  ],
  "additionalProperties": false,
  "title": "screen-annotator project (version 1)",
  "description": "仕様: docs/project-format.md"
}
